{
  "suffix": "example.internal",
  "mode": "lan",
  "lanIp": "",
  "hostsFile": "/etc/hosts",
  "resolver": {
    "port": 53,
    "upstreams": [
      "223.5.5.5",
      "114.114.114.114"
    ],
    "service": "aio-portal-dns",
    "provider": "dnsmasq",
    "fragment": true,
    "configFile": "/etc/dnsmasq.d/intranet/20-aio-portal.conf",
    "testCommand": [
      "dnsmasq",
      "--test"
    ]
  },
  "portal": {
    "root": "/opt/aio-portal",
    "mapPrefix": "10-alias",
    "reload": true
  },
  "gateway": {
    "address": "",
    "adapter": "xiaomi",
    "fallbackDns": "223.5.5.5"
  },
  "caddy": {
    "sitesDir": "/opt/aio-portal/caddy/sites",
    "prefix": "portal-",
    "bind": "",
    "allow": [],
    "denyStatus": 404,
    "binary": "caddy"
  },
  "providers": {
    "dns": "local-dnsmasq",
    "connectivity": "caddy",
    "certificate": "internal-ca",
    "policy": "lan-allowlist",
    "cloud": {
      "cloudflare": {
        "enabled": false,
        "zone": "example.internal",
        "ttl": 120,
        "credentialsEnv": "CLOUDFLARE_API_TOKEN",
        "allowPublicWrite": false
      },
      "dnspod": {
        "enabled": false,
        "zone": "example.internal",
        "ttl": 120,
        "credentialsEnv": "TENCENT_CLOUD_SECRET_ID",
        "allowPublicWrite": false
      },
      "huawei": {
        "enabled": false,
        "zone": "example.internal",
        "ttl": 120,
        "credentialsEnv": "HUAWEI_CLOUD_TOKEN",
        "allowPublicWrite": false
      }
    }
  }
}
