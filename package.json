{
  "name": "@zjarlin/tunnel",
  "version": "0.4.0",
  "description": "Independent service portal for DNS, Caddy and EasyTier; optional AIO sidecar",
  "type": "module",
  "license": "MIT",
  "bin": {
    "aio-plugin-portal": "dist/cli.mjs",
    "tunnel": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "skills",
    "docker-compose.yml",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run check && npm run build && node --test",
    "prepack": "npm run build",
    "prepare": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjarlin/tunnel.git"
  },
  "dependencies": {
    "@huaweicloud/huaweicloud-sdk-core": "^3.1.219",
    "@huaweicloud/huaweicloud-sdk-dns": "^3.1.219",
    "pg": "^8.23.1",
    "tencentcloud-sdk-nodejs-dnspod": "^4.1.266"
  }
}
