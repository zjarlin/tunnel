COMPOSE_PROJECT_NAME=tunnel
TUNNEL_NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
TUNNEL_BIND=127.0.0.1
TUNNEL_PORT=3180
TUNNEL_DATA=/data
# 可选：现有内网 TCP 代理在成功校验配置后生成的服务目录。
TUNNEL_TCP_CATALOG=
TUNNEL_PUBLIC_URL=https://tunnel.example.com
TUNNEL_EXTRA_ORIGINS=
TUNNEL_DOMAIN=example.com
TUNNEL_RAW_HOST=raw.example.com
TUNNEL_LAN_IP=
TUNNEL_ALLOWED_CIDRS=
TUNNEL_ADMIN_USER=admin
TUNNEL_ADMIN_PASSWORD=
TUNNEL_API_TOKEN=
TUNNEL_CADDY_ADMIN=http://127.0.0.1:2019
TUNNEL_CADDY_LISTENER=:443
TUNNEL_CF_ZONE=
TUNNEL_CF_TOKEN=
# AIO 数据库使用只读账号；主机仅在此定义，优先统一灰云域名。
TUNNEL_AIO_DATABASE_URL=
TUNNEL_DATABASE_HOST=database.invalid
TUNNEL_DATABASE_ADDRESS=127.0.0.1
TUNNEL_AIO_TENANT=
TUNNEL_AIO_TENANTS=
TUNNEL_AIO_USERS=
TUNNEL_AIO_ENDPOINT=
TUNNEL_SECRET_KEY=
TUNNEL_VERIFY_UPSTREAM=1
TUNNEL_CADDY_INSTANCES=1
TUNNEL_ADOPT_DOMAINS=
# 配置后，云账号负责 DNS-01 签发与续期，不依赖入站验证端口。
TUNNEL_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
TUNNEL_ACME_EMAIL=
TUNNEL_ACME_RESOLVERS=1.1.1.1,8.8.8.8
TUNNEL_ACME_IP_FAMILY=4
